# Server
NODE_ENV=development
API_PORT=4000
YJS_PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sharespace

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PUBSUB_ENABLED=true

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# JWT — use long random strings in production!
JWT_SECRET=dev_jwt_secret_replace_in_production
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_replace_in_production

# OpenAI (optional — mock responses used if not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Document settings
PUBLIC_DOC_ID_LENGTH=6
SNAPSHOT_INTERVAL_MS=30000

# Logging
LOG_LEVEL=debug
